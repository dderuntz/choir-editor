{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make-run",
            "type": "shell",
            "command": "make run",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "swift-build",
            "type": "shell",
            "command": "swift build",
            "group": "build",
            "problemMatcher": "$swiftc"
        },
        {
            "label": "swift-run",
            "type": "shell",
            "command": "swift run",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        }
    ]
}
