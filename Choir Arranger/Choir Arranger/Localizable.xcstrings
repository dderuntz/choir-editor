    "%@ · %@" : {
      "comment" : "A small label displaying the name of a note, followed by its pitch and start beat. The first argument is the name of the note. The second argument is the start beat of the note.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ %@" : {
