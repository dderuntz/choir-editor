    "help.composerTips.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type lyrics and try different styles with **Recompose**. Tap **Reveal Phonemes** to generate the sounds your choir sings, then copy to the **Piano Roll** to arrange."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv text och prova olika stilar med **Recompose**. Tryck **Reveal Phonemes** för att skapa ljuden din kör sjunger, kopiera sedan till **Piano Roll** för att arrangera."
          }
        }
      }
    },
    "help.composerTips.clickPhoneme" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a phoneme to hear and inspect it"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på ett fonem för att lyssna och inspektera"
          }
        }
      }
    },
    "help.composerTips.copyToRoll" : {
