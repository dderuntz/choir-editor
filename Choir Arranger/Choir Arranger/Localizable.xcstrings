    "settings.composer.privacy" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The composer uses Apple's on-device Foundation Model. All processing happens locally on your Mac — no data is sent to external servers."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Composer använder Apples on-device Foundation Model. All bearbetning sker lokalt på din Mac — ingen data skickas till externa servrar."
          }
        }
      }
    },
    "settings.engine.animalese" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitched speech samples à la Animal Crossing. Playful and chattery."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tonhöjdsförskjutna talsamplingar à la Animal Crossing. Lekfullt och pratigt."
          }
        }
      }
    },
    "settings.engine.fof" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formant-wave-function grains. Breathy, organic vocal texture."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formant-vågfunktionskorn. Andningsrik, organisk vokaltextur."
          }
        }
      }
    },
    "settings.engine.formant" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vowel-shaped resonance filters. Smooth, choir-like tones."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vokalformade resonansfilter. Mjuka, körliknande toner."
          }
        }
      }
    },
    "settings.engine.lpc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linear predictive coding. Robotic, lo-fi speech synthesis."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjär prediktiv kodning. Robotisk, lo-fi-talsyntes."
          }
        }
      }
    },
    "settings.globalEffects" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Global Effects"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Globala effekter"
          }
        }
      }
    },
    "settings.localPlayback" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local Playback"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal uppspelning"
          }
        }
      }
    },
    "settings.lyricStyle.bellman" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm, vivid scenes painted in simple words meant to be sung aloud. Inspired by the bellman — a town crier who sang the news. Golden light, painted windows, that sort of thing."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varma, levande scener målade med enkla ord som ska sjungas högt. Inspirerat av bellman — en stadsropare som sjöng nyheterna. Gyllene ljus, målade fönster, den sortens saker."
          }
        }
      }
    },
    "settings.lyricStyle.dada" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A choir of robots embraces the surreal in the spirit of the Dada art movement. The fork left. The calendar sneezed. You get the idea."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kör av robotar omfamnar det surreella i Dada-rörelsen anda. Gaffeln gick. Kalendern nös. Du fattar."
          }
        }
      }
    },
    "settings.lyricStyle.kulning" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A robot calls lost machines home across mountain valleys using kulning — a Scandinavian herding call meant to carry for miles. Sparse, haunting, nature and wire entwined."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En robot kallar förlorade maskiner hem över fjälldalar med kulning — en skandinavisk vallåt som ska höras milsvitt. Sparsmakat, hemsökt, natur och tråd sammanflätat."
          }
        }
      }
    },
    "settings.lyricStyle.nursery" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nursery rhymes for robots. Timeless and simple in rhyme, fun to say aloud. Cute on the surface, and unsettling in your motherboard."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barnramsor för robotar. Tidlöst och enkelt på rim, roligt att säga högt. Sött på ytan, oroande i moderkortet."
          }
        }
      }
    },
    "settings.lyricStyle.senryu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A weary robot observes life with dry wit and quiet humor using the Japanese form called Senryū. It's like haiku but about human, err robot, nature."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En trött robot observerar livet med torr humor och stilla kvickhet i den japanska formen senryū. Som haiku, men om mänsklig, eh, robotnatur."
          }
        }
      }
    },
    "settings.lyricStyle.svSenryu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En trött robot skriver senryū på svenska. Rad 1 observerar. Rad 2 vänder. Humorn sitter i vändningen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En trött robot skriver senryū på svenska. Rad 1 observerar. Rad 2 vänder. Humorn sitter i vändningen."
          }
        }
      }
    },
