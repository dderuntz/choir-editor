    "composer.phonemeGuide.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each phoneme pairs a consonant with a vowel. Tap any to hear it and tweak its sound. Hit **Play** to hear them sung together, and change the **Key** and **Scale** to shape your melody."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje fonem parar en konsonant med en vokal. Klicka på ett för att lyssna och justera ljudet. Tryck **Play** för att höra dem sjunga tillsammans, och ändra **Key** och **Scale** för att forma din melodi."
          }
        }
      }
    },
