{
  "sourceLanguage" : "en",
  "strings" : {
    "onboarding.welcome.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Composer"
          }
        }
      }
    },
    "onboarding.welcome.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type lyrics, then tap **Reveal Phonemes** to turn them into the sounds your choir sings."
          }
        }
      }
    },
    "onboarding.welcome.dismiss" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let's begin"
          }
        }
      }
    },
    "onboarding.firstPlay.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playing with the built-in synth"
          }
        }
      }
    },
    "onboarding.firstPlay.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dolls are connected, so playback is using the built-in synth. Connect Choir dolls over Bluetooth to hear them sing instead — the synth turns off automatically when they connect."
          }
        }
      }
    },
    "onboarding.firstPlay.connect" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect dolls"
          }
        }
      }
    },
    "onboarding.firstPlay.keepPlaying" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep playing"
          }
        }
      }
    },
    "onboarding.empty.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How do you want to start?"
          }
        }
      }
    },
    "onboarding.empty.composerDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write lyrics in the **Composer** and hear the choir sing them back."
          }
        }
      }
    },
    "onboarding.empty.rollDesc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place **Phonemes** directly on the **Piano Roll** — full control over your arrangement."
          }
        }
      }
    },
    "onboarding.empty.composerBtn" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compose lyrics"
          }
        }
      }
    },
    "onboarding.empty.rollBtn" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manually score"
          }
        }
      }
    },
    "composer.prompt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What will we sing?"
          }
        }
      }
    },
    "onboarding.composer.recomposeTip" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try **Recompose** to stylize your lyrics or prompt — five styles in the **Composer** menu."
          }
        }
      }
    },
    "composer.revealHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn your lyrics into phonemes — the sound elements your choir uses to sing."
          }
        }
      }
    },
    "composer.copyToRollHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy your phonemes to the **Piano Roll** for control over pitch, timing, and arrangement."
          }
        }
      }
    },
    "composer.phonemeGuide.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Phonemes"
          }
        }
      }
    },
    "composer.phonemeGuide.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each phoneme pairs a consonant with a vowel. Tap any to hear it and tweak its sound. Hit **Play** to hear them sung together, and change the **Key** and **Scale** to shape your melody."
          }
        }
      }
    },
    "help.composerTips.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Composer Tips"
          }
        }
      }
    },
    "help.composerTips.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type lyrics and try different styles with **Recompose**. Tap **Reveal Phonemes** to generate the sounds your choir sings, then copy to the **Piano Roll** to arrange."
          }
        }
      }
    },
    "help.composerTips.clickPhoneme" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a phoneme to hear and inspect it"
          }
        }
      }
    },
    "help.composerTips.shiftClick" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shift-click or long-press to toggle harmony"
          }
        }
      }
    },
    "help.composerTips.rightClick" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click a phoneme to insert or delete"
          }
        }
      }
    },
    "help.composerTips.copyToRoll" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Copy to Piano Roll** when you're ready to arrange"
          }
        }
      }
    },
    "onboarding.rollEntry.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano Roll"
          }
        }
      }
    },
    "onboarding.rollEntry.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the grid to place notes. Each note carries a phoneme — a sound element your choir sings."
          }
        }
      }
    },
    "onboarding.rollEntry.startAdding" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
