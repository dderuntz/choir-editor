      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Composer"
          }
        }
      }
    },
    "settings.recompositionStyle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recomposition Style (AI)"
          }
        }
      }
    },
    "settings.lyricStyle.senryu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A weary robot observes life with dry wit and quiet humor using the Japanese form called Senryū. It's like haiku but about human, err robot, nature."
          }
        }
      }
    },
    "settings.lyricStyle.bellman" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warm, vivid scenes painted in simple words meant to be sung aloud. Inspired by the bellman — a town crier who sang the news. Golden light, painted windows, that sort of thing."
          }
        }
      }
    },
    "settings.lyricStyle.kulning" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A robot calls lost machines home across mountain valleys using kulning — a Scandinavian herding call meant to carry for miles. Sparse, haunting, nature and wire entwined."
          }
        }
      }
    },
    "settings.lyricStyle.dada" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A choir of robots embraces the surreal in the spirit of the Dada art movement. The fork left. The calendar sneezed. You get the idea."
          }
        }
      }
    },
    "settings.lyricStyle.nursery" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nursery rhymes for robots. Timeless and simple in rhyme, fun to say aloud. Cute on the surface, and unsettling in your motherboard."
          }
        }
      }
    },
    "settings.lyricStyle.svSenryu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En trött robot skriver senryū på svenska. Rad 1 observerar. Rad 2 vänder. Humorn sitter i vändningen."
          }
        }
      }
    },
    "settings.engine.formant" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vowel-shaped resonance filters. Smooth, choir-like tones."
          }
        }
      }
    },
    "settings.engine.animalese" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitched speech samples à la Animal Crossing. Playful and chattery."
          }
        }
      }
    },
    "settings.engine.fof" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formant-wave-function grains. Breathy, organic vocal texture."
          }
        }
      }
    },
    "settings.engine.lpc" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linear predictive coding. Robotic, lo-fi speech synthesis."
          }
        }
      }
    },
    "settings.composer.privacy" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The composer uses Apple's on-device Foundation Model. All processing happens locally on your Mac — no data is sent to external servers."
          }
        }
      }
    },
    "settings.ccPreSend.warning.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CC Pre-Send"
          }
        }
      }
    },
    "settings.ccPreSend.warning.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing these settings may degrade device playback. The default values work well for most setups."
          }
        }
      }
    },
    "bluetooth.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect Your Choir"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut din kör"
          }
        }
      }
    },
    "bluetooth.subtitle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow these steps to pair your Choir doll via Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ dessa steg för att para din kördocka via Bluetooth."
          }
        }
      }
    },
    "bluetooth.step1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Wake your dolls** — give each one a tap"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Väck dina dockor** — ge varje docka en knackning"
          }
        }
      }
    },
    "bluetooth.step2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Choose your lead doll** — long-press its connect button until it sings *\"Searching for controller\"*"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Välj din huvuddocka** — tryck länge på anslutningsknappen tills den sjunger *\"Searching for controller\"*"
          }
        }
      }
    },
    "bluetooth.step3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Bluetooth window, click **\"Advertise\"**. The doll should sing *\"Connected to MIDI controller\"*"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Bluetooth-fönstret, klicka **\"Advertise\"**. Dockan sjunger *\"Connected to MIDI controller\"*"
          }
        }
      }
    },
    "bluetooth.step4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When macOS asks for a PIN, enter:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När macOS ber om en PIN-kod, ange:"
          }
        }
      }
    },
    "bluetooth.step5" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for connection — this panel will close automatically"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vänta på anslutning — panelen stängs automatiskt"
          }
        }
      }
    },
    "bluetooth.reopenWindow" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reopen Bluetooth Window"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Bluetooth-fönstret igen"
          }
        }
      }
    },
