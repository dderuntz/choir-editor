          "stringUnit" : {
            "state" : "translated",
            "value" : "Early Buffer"
          }
        }
      }
    },
    "settings.ccPreSend.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepares the next sound while the current note is still playing. A larger buffer gives more preparation time but may clip short notes."
          }
        }
      }
    },
    "settings.globalEffects" : {
